{
  "name": "sequelize-nestjs-example",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "provision": "ts-node -r tsconfig-paths/register src/provision.ts",
    "start": "ts-node -r tsconfig-paths/register src/main.ts",
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/main.ts",
    "build": "tsc"
  },
  "dependencies": {
    "@kosan/core": "workspace:*",
    "@kosan/nestjs": "workspace:*",
    "@kosan/sequelize": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "sequelize": "^6.37.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.0"
  }
}
