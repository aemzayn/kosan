{
  "name": "@kosan/express",
  "version": "0.1.0",
  "description": "Express middleware for Kosan — resolves tenant on every request and scopes the connection via AsyncLocalStorage",
  "author": "Kosan Contributors",
  "license": "MIT",
  "keywords": ["multi-tenancy", "express", "middleware", "saas", "typescript"],
  "repository": {
    "type": "git",
    "url": "https://github.com/kosan-dev/kosan.git",
    "directory": "packages/express"
  },
  "homepage": "https://kosan.dev/packages/express",
  "bugs": "https://github.com/kosan-dev/kosan/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "LICENSE", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@kosan/core": "workspace:*"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.2",
    "express": "^4.21.0",
    "supertest": "^7.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
