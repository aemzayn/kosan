{
  "name": "@kosan/cli",
  "version": "0.1.0",
  "description": "CLI for Kosan — run database migrations across all active tenants in parallel",
  "author": "Kosan Contributors",
  "license": "MIT",
  "keywords": [
    "multi-tenancy",
    "cli",
    "migrations",
    "saas",
    "typescript",
    "sequelize"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kosan-dev/kosan.git",
    "directory": "packages/cli"
  },
  "homepage": "https://kosan.dev/packages/cli",
  "bugs": "https://github.com/kosan-dev/kosan/issues",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "bin": {
    "kosan": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@kosan/core": "workspace:*",
    "@kosan/sequelize": "workspace:*",
    "commander": "^12.0.0",
    "jiti": "^1.21.0",
    "sequelize": "^6.37.0",
    "umzug": "^3.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "sqlite3": "^5.1.7",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
