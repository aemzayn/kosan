{
  "name": "@kosan/nestjs",
  "version": "0.1.0",
  "description": "NestJS module for Kosan — tenant guard, decorators, and DI integration for multi-tenancy",
  "author": "Kosan Contributors",
  "license": "MIT",
  "keywords": [
    "multi-tenancy",
    "nestjs",
    "module",
    "guard",
    "saas",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kosan-dev/kosan.git",
    "directory": "packages/nestjs"
  },
  "homepage": "https://kosan.dev/packages/nestjs",
  "bugs": "https://github.com/kosan-dev/kosan/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@kosan/core": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
