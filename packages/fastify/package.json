{
  "name": "@huni/fastify",
  "version": "0.1.0",
  "description": "Fastify plugin for Huni — resolves tenant on every request and scopes the connection via AsyncLocalStorage",
  "author": "Huni Contributors",
  "license": "MIT",
  "keywords": [
    "multi-tenancy",
    "fastify",
    "plugin",
    "saas",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/huni-dev/huni.git",
    "directory": "packages/fastify"
  },
  "homepage": "https://huni.dev/packages/fastify",
  "bugs": "https://github.com/huni-dev/huni/issues",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@huni/core": "workspace:*",
    "fastify-plugin": "^4.5.1"
  },
  "peerDependencies": {
    "fastify": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "fastify": "^4.28.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
