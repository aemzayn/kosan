{
  "name": "@kosan/drizzle",
  "version": "0.1.0",
  "description": "Drizzle ORM adapter for Kosan — one connection pool per tenant, typed schema, dialect-agnostic",
  "author": "Kosan Contributors",
  "license": "MIT",
  "keywords": [
    "multi-tenancy",
    "drizzle",
    "drizzle-orm",
    "database-per-tenant",
    "saas",
    "orm",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kosan-dev/kosan.git",
    "directory": "packages/drizzle"
  },
  "homepage": "https://kosan.dev/packages/drizzle",
  "bugs": "https://github.com/kosan-dev/kosan/issues",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@kosan/core": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.30.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "better-sqlite3": "^9.0.0",
    "drizzle-orm": "^0.41.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
