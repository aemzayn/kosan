{
  "name": "@huni/prisma",
  "version": "0.1.0",
  "description": "Prisma adapter for Huni — one PrismaClient per tenant with per-tenant datasource URL",
  "author": "Huni Contributors",
  "license": "MIT",
  "keywords": [
    "multi-tenancy",
    "prisma",
    "database-per-tenant",
    "saas",
    "orm",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/huni-dev/huni.git",
    "directory": "packages/prisma"
  },
  "homepage": "https://huni.dev/packages/prisma",
  "bugs": "https://github.com/huni-dev/huni/issues",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@huni/core": "workspace:*"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
