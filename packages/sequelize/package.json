{
  "name": "@kosan/sequelize",
  "version": "0.1.0",
  "description": "Sequelize v6 adapter for Kosan — one connection pool per tenant, model factories, slow-query detection",
  "author": "Kosan Contributors",
  "license": "MIT",
  "keywords": [
    "multi-tenancy",
    "sequelize",
    "database-per-tenant",
    "saas",
    "orm",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kosan-dev/kosan.git",
    "directory": "packages/sequelize"
  },
  "homepage": "https://kosan.dev/packages/sequelize",
  "bugs": "https://github.com/kosan-dev/kosan/issues",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@kosan/core": "workspace:*"
  },
  "peerDependencies": {
    "sequelize": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "sequelize": "^6.37.0",
    "sqlite3": "^5.1.7",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
